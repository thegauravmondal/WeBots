  name "target_ball"
}

DEF ROBOT Robot {
  translation 1.6 -1.6 0
  rotation 0 0 1 3.14159
  supervisor TRUE
  children [
    Transform {
      translation 0 0 0.065
      children [ Shape { appearance DEF PEARL PBRAppearance { baseColor 0.92 0.93 0.95 roughness 0.4 metalness 0.0 } geometry Box { size 0.2 0.12 0.06 } } ]
    }
    Transform {
      translation 0 0 0.097
      children [ Shape { appearance USE TEAL geometry Box { size 0.16 0.1 0.006 } } ]
    }
    Camera {
      translation 0.1 0 0.09
      name "camera"
      width 64
      height 48
      fieldOfView 1.2
    }
    Lidar {
      translation 0.06 0 0.11
      name "lidar"
      children [
        Transform {
          translation 0 0 -0.01
          children [ Shape { appearance USE CHAR geometry Box { size 0.04 0.04 0.03 } } ]
        }
      ]
      horizontalResolution 180
      fieldOfView 3.14159
      numberOfLayers 1
      verticalFieldOfView 0.05
      minRange 0.05
      maxRange 2.5
    }
    Transform {
      translation 0.08 0 0.02
      children [ Shape { appearance USE CHAR geometry Sphere { radius 0.02 } } ]
    }
    Transform {
      translation -0.08 0 0.02
      children [ Shape { appearance USE CHAR geometry Sphere { radius 0.02 } } ]
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 0.08 0.04 }
      device [
        RotationalMotor { name "left wheel motor" maxVelocity 15 }
        PositionSensor { name "left wheel sensor" }
      ]
      endPoint Solid {
        translation 0 0.08 0.04
        children [
          Transform {
            rotation 1 0 0 1.5708
            children [ Shape { appearance DEF RUBBER PBRAppearance { baseColor 0.05 0.05 0.05 roughness 1.0 metalness 0.0 } geometry Cylinder { height 0.02 radius 0.04 } } ]
          }
        ]
        name "left wheel"
        boundingObject Transform {
          rotation 1 0 0 1.5708
          children [ Cylinder { height 0.02 radius 0.04 } ]
        }
        physics Physics { density -1 mass 0.15 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 -0.08 0.04 }
      device [
        RotationalMotor { name "right wheel motor" maxVelocity 15 }
        PositionSensor { name "right wheel sensor" }
      ]
      endPoint Solid {
        translation 0 -0.08 0.04
        children [
          Transform {
            rotation 1 0 0 1.5708
            children [ Shape { appearance USE RUBBER geometry Cylinder { height 0.02 radius 0.04 } } ]
          }
        ]
        name "right wheel"
        boundingObject Transform {
          rotation 1 0 0 1.5708
          children [ Cylinder { height 0.02 radius 0.04 } ]
        }
        physics Physics { density -1 mass 0.15 }
      }
    }
  ]
  name "search_robot"
  contactMaterial "caster"
  boundingObject Group {
    children [
      Transform {
        translation 0 0 0.065
        children [ Box { size 0.2 0.12 0.06 } ]
      }
      Transform {
        translation 0.08 0 0.02
        children [ Sphere { radius 0.02 } ]
      }
      Transform {
        translation -0.08 0 0.02
        children [ Sphere { radius 0.02 } ]
      }
    ]
  }
  physics Physics {
    density -1
    mass 1.0
    centerOfMass [ 0 0 0.04 ]
  }
  controller "search_robot"
}
